{
  "name": "@fuzzynuts/api",
  "version": "0.1.0",
  "private": true,
  "description": "Express service deployed to Railway at world.fuzzynuts.xyz. Handles score submission, weekly rewards, wallet auth, and SSE leaderboard stream.",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@fuzzynuts/arcade-core": "workspace:*",
    "@fuzzynuts/shared-anticheat": "workspace:*",
    "@fuzzynuts/xrpl-token-utils": "workspace:*",
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "helmet": "^8.2.0",
    "jose": "^5.9.0",
    "mongodb": "^6.10.0",
    "node-cron": "^3.0.3",
    "socket.io": "^4.8.0",
    "xrpl": "^4.0.0",
    "xumm-sdk": "^1.11.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fuzzynuts/tsconfig": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  }
}
