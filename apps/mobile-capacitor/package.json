{
  "name": "@fuzzynuts/mobile-capacitor",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor 7 mobile shell (iOS + Android) wrapping the @fuzzynuts/web-arcade static export.",
  "type": "module",
  "scripts": {
    "cap": "cap",
    "sync": "cap sync",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "build:android": "cap sync android && cd android && ./gradlew assembleRelease",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf android ios .turbo"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@fuzzynuts/tsconfig": "workspace:*",
    "typescript": "^5.6.0"
  }
}
