# Fuzzynuts Environment Variables
# Copy this file to .env.local and fill in your values

# Required: Xaman (Xumm) API key — get one at https://apps.xaman.dev
NEXT_PUBLIC_XAMAN_API_KEY=

# Required: Your production URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://fuzzynuts.xyz

# Launch switch: search-engine indexing (default: off / noindex).
# Keep unset (or any value other than "true") during pre-launch so the site
# stays out of Google. Set to "true" and redeploy when you're ready to go live.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Optional: XRPL WebSocket node
NEXT_PUBLIC_XRPL_NODE=wss://xrplcluster.com

# Optional: Override token addresses (defaults are production)
NEXT_PUBLIC_NUT_ISSUER=rpL6HfoV578CAkZoNbm3UEK5BgVY9DxMP7
NEXT_PUBLIC_NUT_DISTRIBUTOR=rEAg6fmrKyCFahqY4KNfbFx4BN2KjR4BZh
NEXT_PUBLIC_NUT_AMM_POOL=r3UzuHQQQGZRPhxzFFGbzgJYCb76ESJxtg

# Pre-launch: HTTP Basic Auth lockdown password
# Set this to enable site-wide password protection at the edge.
# If unset, the site returns 503 for ALL requests (fail-closed).
SITE_LOCKDOWN_PASSWORD=
