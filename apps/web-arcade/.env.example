# Fuzzynuts web-arcade (Next.js) — copy to .env.local and fill in.

# Required: Xaman (Xumm) API key — https://apps.xaman.dev
NEXT_PUBLIC_XAMAN_API_KEY=

# Required: production URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://fuzzynuts.xyz

# API base the browser calls (defaults to prod Railway in code)
NEXT_PUBLIC_API_BASE=https://world.fuzzynuts.xyz/api

# Joey / WalletConnect via Reown — PUBLIC client id (cloud.reown.com)
NEXT_PUBLIC_PROJECT_ID=

# Server-Sent Events for live scores
NEXT_PUBLIC_SSE=true

# Search-engine indexing: keep != "true" pre-launch
NEXT_PUBLIC_ALLOW_INDEXING=false

# Optional XRPL WebSocket node
NEXT_PUBLIC_XRPL_NODE=wss://xrplcluster.com

# Optional token address overrides (defaults are production)
NEXT_PUBLIC_NUT_ISSUER=rpL6HfoV578CAkZoNbm3UEK5BgVY9DxMP7
NEXT_PUBLIC_NUT_DISTRIBUTOR=rEAg6fmrKyCFahqY4KNfbFx4BN2KjR4BZh
NEXT_PUBLIC_NUT_AMM_POOL=r3UzuHQQQGZRPhxzFFGbzgJYCb76ESJxtg

# Admin wallet (gates admin UI)
NEXT_PUBLIC_ADMIN_WALLET=

# Chat API endpoint (if chat enabled)
NEXT_PUBLIC_CHAT_API=

# Secure-site origin (RSC iframe origin check)
NEXT_PUBLIC_SECURE_SITE_ORIGIN=https://fuzzynuts.xyz

# Pre-launch site-wide HTTP Basic Auth password (fail-closed if unset)
SITE_LOCKDOWN_PASSWORD=

# ── NextAuth.js (Web2 + Web3 hybrid auth) ──
# Generate a secret: openssl rand -base64 32
NEXTAUTH_URL=https://fuzzynuts.xyz
NEXTAUTH_SECRET=

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID (Web application)
# 2. Authorized JavaScript origins: https://fuzzynuts.xyz
# 3. Authorized redirect URIs: https://fuzzynuts.xyz/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# API URL (for XRPL wallet auth flow)
NEXT_PUBLIC_API_URL=https://fuzzynutsxyz-production.up.railway.app
