FROM node:22-slim

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

WORKDIR /app

# Copy workspace root files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./

# Copy workspace packages needed by the API
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/

# Copy entrypoint
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Install dependencies
RUN pnpm install --frozen-lockfile

# Debug: verify files exist
RUN echo "=== FILES ===" && ls -la apps/api/src/server.ts && echo "=== NODE ===" && node --version

EXPOSE 4000

# Simple test: can the container start?
CMD ["node", "-e", "console.log('Container started!'); setTimeout(() => console.log('Still alive...'), 5000);"]
