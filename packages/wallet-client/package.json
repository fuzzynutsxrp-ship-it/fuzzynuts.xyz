{
  "name": "@fuzzynuts/wallet-client",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-side wallet adapters (Xaman, Joey) + the SignIn challenge/verify flow. Consumes the API's /api/auth/{challenge,verify} endpoints.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./providers/xaman": "./src/providers/xaman.ts",
    "./providers/joey": "./src/providers/joey.ts",
    "./signin": "./src/signin.ts",
    "./session": "./src/session.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "echo '(no tests yet — adapter migration tracked in follow-up PR)'",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@fuzzynuts/arcade-core": "workspace:*",
    "@fuzzynuts/shared-anticheat": "workspace:*"
  },
  "devDependencies": {
    "@fuzzynuts/tsconfig": "workspace:*",
    "typescript": "^5.6.0"
  }
}
