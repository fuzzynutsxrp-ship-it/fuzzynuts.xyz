{
  "name": "@fuzzynuts/xrpl-token-utils",
  "version": "0.1.0",
  "private": true,
  "description": "XRPL client factory (mainnet / altnet), signature verification, NUT AMM pricing, and multisig-aware payouts. Server-side only — never bundle into the browser.",
