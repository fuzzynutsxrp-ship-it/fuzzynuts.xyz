{
  "name": "@fuzzynuts/shared-anticheat",
  "version": "0.1.0",
  "private": true,
  "description": "HMAC, nonce, and game-session-token primitives shared between web-arcade and api. Crypto via Web Crypto API — runs in Node 20 and the browser.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./hmac": "./src/hmac.ts",
    "./nonce": "./src/nonce.ts",
    "./session-token": "./src/session-token.ts",
    "./game-session-hmac": "./src/game-session-hmac.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@fuzzynuts/arcade-core": "workspace:*"
  },
  "devDependencies": {
    "@fuzzynuts/tsconfig": "workspace:*",
    "@types/node": "^20",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
