{
  "name": "@fuzzynuts/arcade-core",
  "version": "0.1.0",
  "private": true,
  "description": "Single source of truth for arcade constants, slug map, and the score-payload schema. Consumed by web-arcade, api, and games-build.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/constants/index.ts",
    "./schema": "./src/schema/index.ts",
    "./types": "./src/types/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "echo '(arcade-core uses repo-root eslint)'",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fuzzynuts/tsconfig": "workspace:*",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
