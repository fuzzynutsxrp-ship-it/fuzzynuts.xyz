{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|woff|woff2|png|jpg|svg|ico|webp|mp4|wasm)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    { "source": "/arcade", "destination": "/#games", "permanent": false },
    { "source": "/arcade/", "destination": "/#games", "permanent": false },
    { "source": "/games/mirage-realms", "destination": "/games/top-secret", "permanent": false },
    { "source": "/games/mirage-realms/", "destination": "/games/top-secret/", "permanent": false },
    { "source": "/games/mirage-realms/:path*", "destination": "/games/top-secret/:path*", "permanent": false }
  ]
}
