# ═══════════════════════════════════════════════════════════════
#  FuzzyNuts Monorepo — Environment Variables
#
#  Copy this file to .env and fill in the values.
#  Never commit .env with real secrets.
# ═══════════════════════════════════════════════════════════════

# ── Game Server Toggle ─────────────────────────────────────────
# Set to "true" after the Open-RSC VPS is deployed and reachable.
# While "false", the /api/auth/game-session endpoint returns 503
# and the /play/rsc page shows a "Server Provisioning" message.
GAME_SERVER_READY=false

# ── Game Session ───────────────────────────────────────────────
# Secret for HMAC-signing game session tokens. Generate with:
#   openssl rand -hex 32
GAME_SESSION_SECRET=a3f8c1d2e4b59607182f3a4c5d6e7f8091a2b3c4d5e6f708192a3b4c5d6e7f80

# TCP endpoint where the Open-RSC game server listens.
# Must match the port in server/local.conf on the VPS.
OPENRSC_GAME_ENDPOINT=fuzzynuts.xyz:43594

# ── XRPL ───────────────────────────────────────────────────────
# "mainnet" for production, "altnet" for XRPL testnet.
XRPL_NETWORK=mainnet

# ── MongoDB (API backend) ──────────────────────────────────────
MONGO_URL=mongodb://localhost:27017/fuzzynuts

# ── Wallet Auth ────────────────────────────────────────────────
# Xumm API key (for Xaman/Joey wallet integration).
XUMM_API_KEY=

# JWT secret for wallet session cookies. Generate with:
#   openssl rand -hex 32
WALLET_JWT_SECRET=change-me-to-256-bit-hex

# ── XRPL Token ─────────────────────────────────────────────────
# NUT token issuer address on XRPL.
NUT_ISSUER=

# NUT distributor address (hot wallet for payouts).
NUT_DISTRIBUTOR=
