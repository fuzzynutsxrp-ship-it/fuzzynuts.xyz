# ═══════════════════════════════════════════════════════════════
#  FuzzyNuts Monorepo — Environment Variables
#  Copy to .env and fill in. NEVER commit .env with real secrets.
# ═══════════════════════════════════════════════════════════════

# ── Frontend → API URL (optional override; code defaults to prod) ──
# NEXT_PUBLIC_API_URL=https://world.fuzzynuts.xyz

# ── Game server toggle ──
# "true" once the Open-RSC VPS is live; while "false" the
# /api/auth/game-session endpoint 503s and /play/rsc shows "provisioning".
GAME_SERVER_READY=false

# ── Game session signing (HMAC). Generate: openssl rand -hex 32 ──
GAME_SESSION_SECRET=__GENERATE_WITH_openssl_rand_hex_32__

# TCP endpoint where the Open-RSC game server listens.
OPENRSC_GAME_ENDPOINT=fuzzynuts.xyz:43594

# ── XRPL ── ("mainnet" prod, "altnet" testnet)
XRPL_NETWORK=mainnet

# ── MongoDB (API backend) ── NOTE: code reads MONGODB_URI (not MONGO_URL)
MONGODB_URI=mongodb://localhost:27017/fuzzynuts

# ── Wallet / auth ──
# JWT secret for wallet session cookies. Generate: openssl rand -hex 32
WALLET_JWT_SECRET=__GENERATE_WITH_openssl_rand_hex_32__

# ── XRPL token (server-side) ──
NUT_ISSUER=
NUT_DISTRIBUTOR=
# Allow single-sig payouts (dev only; prod should be multisig)
ALLOW_SINGLE_SIG_PAYOUT=false

# ── Admin / monitoring ──
ADMIN_WALLET_ADDRESS=
DISCORD_WEBHOOK_URL=
# Score-submission HMAC + server secret. Generate each: openssl rand -hex 32
SCORE_HMAC_SECRET=__GENERATE_WITH_openssl_rand_hex_32__
SERVER_SECRET=__GENERATE_WITH_openssl_rand_hex_32__

# ── Chat feature (server) ──
OPENAI_API_KEY=

# ── RSC two-tier auth ──
RSC_PASSWORD_SECRET=__GENERATE_WITH_openssl_rand_hex_32__

# ── VPS account server (Open-RSC) ──
VPS_ACCOUNT_URL=http://127.0.0.1:3001
VPS_ACCOUNT_SECRET=

# ── Pricing / emissions (optional tuning) ──
NUT_USD_PRICE_FALLBACK=
MAX_WEEKLY_NUT_EMISSION=
COMMUNITY_NUT_JAR_SEED=
# NUT_AMM_COUNTER_CURRENCY=
# NUT_AMM_COUNTER_ISSUER=
# NUT_AMM_COUNTER_IS_XRP=
# PRIZE_USD_1= / PRIZE_USD_2= / PRIZE_USD_3=
