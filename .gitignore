# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Turborepo ────────────────────────────────────────────────
.turbo/

# ── Next.js (apps/web-arcade) ────────────────────────────────
.next/
next-env.d.ts

# ── Build outputs ────────────────────────────────────────────
out/
dist/
build/
coverage/
*.tsbuildinfo

# ── Games build output (regenerated from apps/games-build) ──
apps/web-arcade/public/games/*
!apps/web-arcade/public/games/.gitkeep
!apps/web-arcade/public/games/rsc/
!apps/web-arcade/public/games/dragon-hoard/
!apps/web-arcade/public/games/cosmic-blaster/
!apps/web-arcade/public/games/mario/
!apps/web-arcade/public/games/fuzzy-survivors/
!apps/web-arcade/public/games/minigolf/
!apps/web-arcade/public/games/nut-racer/
!apps/web-arcade/public/games/fuzzynuts-world/
!apps/web-arcade/public/games/top-secret/
!apps/web-arcade/public/games/fuzzy-score.js

# ── Tauri ────────────────────────────────────────────────────
apps/desktop-tauri/src-tauri/target/
apps/desktop-tauri/src-tauri/Cargo.lock

# ── Capacitor (native projects regenerated locally) ─────────
apps/mobile-capacitor/android/
apps/mobile-capacitor/ios/

# ── Environment files (never commit real secrets) ───────────
.env
.env.*
!.env.example

# ── Vercel local link ────────────────────────────────────────
.vercel/

# ── IDE + OS ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ── Misc ─────────────────────────────────────────────────────
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel
